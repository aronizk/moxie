# --- Server ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- Database ---
# Postgres connection string, e.g. from Neon, Supabase, Railway, RDS, or local Postgres.
# Example local:      postgres://postgres:postgres@localhost:5432/ticketin
# Example Neon/Supabase (needs SSL): postgres://user:pass@host:5432/db?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ticketin
DATABASE_SSL=false

# --- Auth ---
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Platform ---
PLATFORM_FEE_RATE=0.10

# --- File storage ---
# 'local' (default) saves uploaded payment-proof screenshots to this server's own disk —
# no third-party account needed, works great for local dev and single-server setups.
# Set to 's3' (and fill in the S3_* block below) to use real S3-compatible object storage
# instead — useful later if you deploy somewhere the local disk won't persist between restarts.
STORAGE_DRIVER=local

# --- S3-compatible object storage (only used if STORAGE_DRIVER=s3 above) ---
# Works with AWS S3, Cloudflare R2, Backblaze B2, MinIO, DigitalOcean Spaces, etc.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=ticketin-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Public base URL to read back uploaded files (bucket public-read, or your CDN domain)
S3_PUBLIC_URL_BASE=

# --- Bootstrap admin (used by npm run seed:admin) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
